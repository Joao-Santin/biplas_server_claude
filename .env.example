# ---- Servidor -------------------------------------------------------------
# 0.0.0.0 = acessível pelos computadores da rede; 127.0.0.1 = só esta máquina
HOST=0.0.0.0
PORT=3000

# Opcional: se definida, toda rota /api exige o header  x-api-key: <valor>
# API_KEY=

# Nível de log. Ex.: info, debug, biplas_server_claude=debug
RUST_LOG=info

# ---- PostgreSQL ---------------------------------------------------------
# Necessária para a sincronização e para as rotas de dados (sem ela, 503).
# DATABASE_URL=postgres://biplas:SENHA@localhost:5432/BiplasBD

# ---- eGestor --------------------------------------------------------------
# personal_token (JWT) gerado em Configurações -> API no eGestor.
# O servidor troca por access_token (15 min) e renova sozinho.
TOKENEGESTOR=
EGESTOR_BASE_URL=https://v4.egestor.com.br/api

# ---- Trello ---------------------------------------------------------------
# API key: https://trello.com/power-ups/admin -> crie um Power-Up -> "API key"
TRELLO_KEY=
# Token somente leitura. Abra no navegador, trocando SUA_KEY:
# https://trello.com/1/authorize?expiration=never&scope=read&response_type=token&name=biplas-server&key=SUA_KEY
TRELLO_TOKEN=
# Nome do quadro (maiúsculas e acentos são ignorados)
TRELLO_BOARD=Programação Máquinas
# Opcional: ID do quadro, para pular a busca pelo nome
# TRELLO_BOARD_ID=
# Listas servidas, separadas por ';', na ordem da resposta
TRELLO_LISTS=Aguardando Máquina;Em andamento;Concluído

# ---- Sincronização ----------------------------------------------------------
# O servidor busca eGestor e Trello sozinho, grava no banco e os programas leem
# de lá. Intervalo em minutos (0 = só quando um programa pedir em /api/sync).
SYNC_EGESTOR_MIN=30
SYNC_TRELLO_MIN=5
